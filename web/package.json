{
  "name": "9router-web",
  "version": "0.5.85",
  "description": "9Router dashboard SPA (pure React + Vite) — replaces the Next.js frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun run scripts/sync-ui.ts",
    "dev": "bun run sync && vite --port 20183 --strictPort",
