    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "marked": "^18.0.1",
    "prop-types": "^15.8.1",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.55.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.7.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^4.3.4",
