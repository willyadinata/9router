{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "open-sse": ["../open-sse/index.js"],
      "open-sse/*": ["../open-sse/*"],
      "next/server": ["./src/shims/next-server.ts"],
      "next/headers": ["./src/shims/next-headers.ts"]
    }
  },
  "include": ["src/**/*"]
}
